# Adapted from compute.py InstancePoolParams schema
# aws_source_id = {{ aws_source_id }}
resource "oci_core_instance_pool" "{{ label }}" {
  compartment_id            = {{ compartment_id }}
  display_name              = "{{ display_name }}"
  instance_configuration_id = {{ instance_configuration_id }}
  size                      = {{ size }}

{% for placement in placement_configurations %}
  placement_configurations {
    availability_domain = "{{ placement.availability_domain }}"
    primary_subnet_id   = {{ placement.primary_subnet_id }}
  }
{% endfor %}

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
