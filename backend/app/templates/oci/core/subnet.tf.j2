# Adapted from ai-accelerator-tf/network.tf
# aws_source_id = {{ aws_source_id }}
resource "oci_core_subnet" "{{ label }}" {
  compartment_id             = {{ compartment_id }}
  vcn_id                     = {{ vcn_id }}
  cidr_block                 = "{{ cidr_block }}"
  display_name               = "{{ display_name }}"
{% if dns_label is defined and dns_label %}
  dns_label                  = "{{ dns_label }}"
{% endif %}
  prohibit_public_ip_on_vnic = {{ prohibit_public_ip_on_vnic | lower }}
{% if route_table_id is defined and route_table_id %}
  route_table_id             = {{ route_table_id }}
{% endif %}
{% if security_list_ids is defined and security_list_ids %}
  security_list_ids          = [{{ security_list_ids | join(', ') }}]
{% endif %}
{% if dhcp_options_id is defined and dhcp_options_id %}
  dhcp_options_id            = {{ dhcp_options_id }}
{% endif %}

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
