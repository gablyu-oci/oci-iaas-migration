# Adapted from OCI provider documentation
# aws_source_id = {{ aws_source_id }}
resource "oci_core_public_ip" "{{ label }}" {
  compartment_id = {{ compartment_id }}
  lifetime       = "{{ lifetime | default('RESERVED') }}"
  display_name   = "{{ display_name }}"
{% if private_ip_id is defined and private_ip_id %}
  private_ip_id  = {{ private_ip_id }}
{% endif %}

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
