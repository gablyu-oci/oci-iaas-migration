# Adapted from OCI Logging documentation
# aws_source_id = {{ aws_source_id }}
resource "oci_logging_log_group" "{{ label }}" {
  compartment_id = {{ compartment_id }}
  display_name   = "{{ display_name }}"
{% if description is defined and description %}
  description    = "{{ description }}"
{% endif %}

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
