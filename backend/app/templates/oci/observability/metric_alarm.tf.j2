# Adapted from OCI Monitoring documentation
# aws_source_id = {{ aws_source_id }}
resource "oci_monitoring_alarm" "{{ label }}" {
  compartment_id        = {{ compartment_id }}
  display_name          = "{{ display_name }}"
  metric_compartment_id = {{ metric_compartment_id }}
  namespace             = "{{ namespace }}"
  query                 = "{{ query }}"
  severity              = "{{ severity }}"
  destinations          = [{{ destinations | join(', ') }}]
  is_enabled            = {{ is_enabled | lower }}
{% if body is defined and body %}
  body                  = "{{ body }}"
{% endif %}
{% if pending_duration is defined and pending_duration %}
  pending_duration      = "{{ pending_duration }}"
{% endif %}
{% if repeat_notification_duration is defined and repeat_notification_duration %}
  repeat_notification_duration = "{{ repeat_notification_duration }}"
{% endif %}

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
