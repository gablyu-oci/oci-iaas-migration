# Adapted from ai-accelerator-tf/policies.tf
# aws_source_id = {{ aws_source_id }}
resource "oci_identity_user" "{{ label }}" {
  compartment_id = {{ compartment_id }}
  name           = "{{ name }}"
  description    = "{{ description }}"
{% if email is defined and email %}
  email          = "{{ email }}"
{% endif %}

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
