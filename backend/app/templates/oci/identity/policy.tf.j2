# Adapted from ai-accelerator-tf/policies.tf and oci-policies/main.tf
# aws_source_id = {{ aws_source_id }}
resource "oci_identity_policy" "{{ label }}" {
  compartment_id = {{ compartment_id }}
  name           = "{{ name }}"
  description    = "{{ description }}"
  statements     = [
{% for stmt in statements %}
    "{{ stmt }}"{{ "," if not loop.last }}
{% endfor %}
  ]

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
