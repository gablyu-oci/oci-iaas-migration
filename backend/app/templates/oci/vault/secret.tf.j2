# Adapted from oci-vault-kms/main.tf
# aws_source_id = {{ aws_source_id }}
resource "oci_vault_secret" "{{ label }}" {
  compartment_id = {{ compartment_id }}
  vault_id       = {{ vault_id }}
  key_id         = {{ key_id }}
  secret_name    = "{{ secret_name }}"
{% if description is defined and description %}
  description    = "{{ description }}"
{% endif %}

  secret_content {
    content_type = "{{ secret_content.content_type }}"
    content      = "{{ secret_content.content }}"
  }

{% if freeform_tags is defined and freeform_tags %}
  freeform_tags = {
{% for key, value in freeform_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
